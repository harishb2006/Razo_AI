# Set to true to run with zero external services (mongomock, no LLM keys needed).
OFFLINE_MODE=True

# MongoDB Atlas M0 connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=razo_ai

# Insert-only Atlas user for the audit_events collection (find + insert only).
# Falls back to MONGODB_URI if unset.
MONGODB_AUDIT_URI=

# X-API-Key required on write endpoints.
API_KEY=dev-local-key

CORS_ORIGINS=["http://localhost:5173"]

# Razorpay test mode. Leave blank to use the deterministic fake client —
# checkout still works end to end, it just doesn't hit Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
