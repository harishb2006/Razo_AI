# Set to true to run with zero external services (mongomock, no LLM keys needed).
OFFLINE_MODE=True

# MongoDB Atlas M0 connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=razo_ai

# Insert-only Atlas user for the audit_events collection (find + insert only).
# Falls back to MONGODB_URI if unset.
MONGODB_AUDIT_URI=

# X-API-Key required on write endpoints.
API_KEY=dev-local-key

CORS_ORIGINS=["http://localhost:5173"]

# LLM chain: gemini -> groq -> echo. Each link is optional — with no keys at
# all the local `echo` provider still answers, so a keyless clone runs.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER_CHAIN=gemini,groq,echo
# Provider model ids. Both retire old ids periodically — if you see
# 404 model_not_found, list the live ones and update these two lines.
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-20b

# HMAC key for signed policy verdicts: openssl rand -hex 32
# Falls back to API_KEY if left blank.
VERDICT_SIGNING_KEY=

# Razorpay test mode. Leave blank to use the deterministic fake client —
# checkout still works end to end, it just doesn't hit Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
